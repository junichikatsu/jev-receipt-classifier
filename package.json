{
  "name": "jev-sample",
  "version": "1.0.0",
  "description": "Jev (TypeSafe AI) で家計簿レシートを自動分類するサンプル",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "batch": "node --env-file-if-exists=.env src/batch.ts",
