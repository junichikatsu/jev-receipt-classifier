  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
